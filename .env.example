# Names only — never commit values. Required variables have no defaults;
# the service refuses to start if they are missing.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=          # required
DB_NAME=
DB_SSLMODE=           # optional, default "require" (disable|allow|prefer|require|verify-ca|verify-full)
INTERNAL_JWT_SECRET=  # required, at least 32 characters; same value as on the Go backend
ENABLE_DOCS=          # optional; "true" serves /docs, /redoc, /openapi.json
